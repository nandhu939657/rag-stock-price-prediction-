# ============================================================================
# Single .env file for the WHOLE project (backend + frontend), at the repo root.
#
# The backend (FastAPI) reads every variable below directly.
# The frontend (Vite) only ever reads variables prefixed with VITE_ - Vite
# strips everything else out of the client bundle automatically, so the
# secret keys below (Supabase service role, Groq, Infoway, Firecrawl, Apify,
# the DB password) never reach the browser even though they live in this same
# file. See vite.config.ts (envDir) and backend/app/config.py (env_file).
# ============================================================================

# --- Supabase (backend: full access via service_role) ---
SUPABASE_URL=https://snpytsdvqlikpsmavmpo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNucHl0c2R2cWxpa3BzbWF2bXBvIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MDA2OTUzMSwiZXhwIjoyMTA1NjQ1NTMxfQ.fgf1kgS-UggFA8P29LfpWBb00tY1pU_qtZDQ_YIgUn0
DATABASE_URL=postgresql://postgres.snpytsdvqlikpsmavmpo:Nandhu21433@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# --- Groq (LLM synthesis) ---
GROQ_API_KEY=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
GROQ_MODEL=openai/gpt-oss-120b

# --- Market data (OHLCV) - Infoway (https://infoway.io/). Note: Infoway issues a
# 7-day free trial key by default - if this starts failing after working before,
# the trial may have expired and need renewing/upgrading on their site. ---
MARKET_DATA_API_KEY=14fa58e2db29428285a691cecf36d1e4-infoway

# --- Firecrawl (news/article scraping) ---
FIRECRAWL_API_KEY=fc-cc446fdc36ef451c956ae7aab5e20d7c

# --- Apify (news/sentiment actor runs) ---
APIFY_API_TOKEN=apify_api_1ef1pzhLbGydYpKghnhg3z8EqihiIR1B6qBM
APIFY_NEWS_ACTOR_ID=apify~google-search-scraper

# --- Backend app config ---
SCHEDULER_INTERVAL_MINUTES=5
NEWS_RESCRAPE_INTERVAL_HOURS=1
CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vite) - VITE_ prefix required, and these are safe to expose to the
# browser: the anon key is meant to be public (Postgres RLS is what actually protects
# data, not secrecy of this key). ---
VITE_SUPABASE_URL=https://snpytsdvqlikpsmavmpo.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNucHl0c2R2cWxpa3BzbWF2bXBvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAwNjk1MzEsImV4cCI6MjEwNTY0NTUzMX0.UWqqUU3fS7lqEyRQMAt0dN-qerrjWKJPDZpFZXgv7WU
VITE_API_BASE_URL=http://localhost:8000
