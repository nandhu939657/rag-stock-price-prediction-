# Environment secrets - never commit (single root .env shared by backend + frontend)
.env
.env.local
.env.*.local

# Python
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.egg-info/
backend/app/ml/artifacts/*.json
backend/app/ml/artifacts/*.pkl
!backend/app/ml/artifacts/.gitkeep

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
*.log
