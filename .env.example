# ============================================================================
# Single .env file for the WHOLE project (backend + frontend), at the repo root.
# Copy this file to ".env" (same folder) and fill in every value.
#
# The backend (FastAPI) reads every variable below directly.
# The frontend (Vite) only ever reads variables prefixed with VITE_ - Vite
# strips everything else out of the client bundle automatically, so the
# secret keys below never reach the browser even though they live in this
# same file. See vite.config.ts (envDir) and backend/app/config.py (env_file).
# ============================================================================

# --- Supabase (backend: full access via service_role) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Groq (LLM synthesis) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Market data (OHLCV) - Infoway (https://infoway.io/) ---
MARKET_DATA_API_KEY=

# --- Firecrawl (news/article scraping) ---
FIRECRAWL_API_KEY=

# --- Apify (news/sentiment actor runs) ---
APIFY_API_TOKEN=
APIFY_NEWS_ACTOR_ID=apify~google-search-scraper

# --- Backend app config ---
SCHEDULER_INTERVAL_MINUTES=5
NEWS_RESCRAPE_INTERVAL_HOURS=1
CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vite) - VITE_ prefix required ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8000
